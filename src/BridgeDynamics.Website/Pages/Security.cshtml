@page
@{ ViewData["Title"]="Security"; ViewData["Description"]="Security, access control, tenant isolation and audit capabilities in Bridge Dynamics."; }
<partial name="_PageHero" model='new PageHero("Security and trust","Responsible access. Protected information. Accountable operations.","Bridge Dynamics is designed with enterprise controls that support confidentiality, separation of customer data and traceable business activity.")' />
<section class="section"><div class="container-xl"><div class="card-grid">@foreach(var item in new[]{("Role-based security","Control access according to job responsibilities and authorised business functions."),("Tenant isolation","Maintain logical separation between each customer organisation and its information."),("Audit capabilities","Support accountability with traceable activity and business-record history where configured."),("Data protection","Apply responsible handling principles across access, storage, transmission and operations."),("Secure deployment","Use controlled environments, encrypted transport and disciplined release practices."),("Operational governance","Combine permissions, approvals and activity history to support internal control.")}){<article class="info-card"><div class="icon-box" aria-hidden="true">✓</div><h2 class="h4">@item.Item1</h2><p>@item.Item2</p></article>}</div></div></section>
<section class="section section-dark"><div class="container-xl"><div class="row g-5"><div class="col-lg-6"><p class="eyebrow eyebrow-light">Clear and responsible claims</p><h2>Security depends on technology, process and deployment context</h2></div><div class="col-lg-6"><p>Specific security controls and deployment arrangements are confirmed during solution design. Bridge Dynamics does not represent certifications or independent attestations that have not been formally obtained.</p><a class="btn btn-light" asp-page="/Contact">Discuss security requirements</a></div></div></div></section><partial name="_FinalCta" />
