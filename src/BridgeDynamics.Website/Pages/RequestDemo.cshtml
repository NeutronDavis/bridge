@page "/request-demo"
@model RequestDemoModel
@{ ViewData["Title"]="Request a Demonstration"; ViewData["Description"]="Request a tailored demonstration of the Bridge Dynamics enterprise platform."; }
<partial name="_PageHero" model='new PageHero("Request a demonstration","See Bridge Dynamics in the context of your organisation","Tell us about your operating priorities. Our enterprise solutions team will use the information to prepare a relevant conversation.")' />
<section class="section section-muted"><div class="container-xl"><form method="post" class="form-shell mx-auto" novalidate>
<p class="mb-4">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">required</span> are required.</p><div asp-validation-summary="ModelOnly" role="alert"><strong>Please review the highlighted fields.</strong></div><div class="row g-4">
<div class="col-md-6"><label asp-for="Input.FullName" class="form-label"></label> <span aria-hidden="true">*</span><input asp-for="Input.FullName" class="form-control" autocomplete="name" /><span asp-validation-for="Input.FullName"></span></div>
<div class="col-md-6"><label asp-for="Input.Company" class="form-label"></label> <span aria-hidden="true">*</span><input asp-for="Input.Company" class="form-control" autocomplete="organization" /><span asp-validation-for="Input.Company"></span></div>
<div class="col-md-6"><label asp-for="Input.WorkEmail" class="form-label"></label> <span aria-hidden="true">*</span><input asp-for="Input.WorkEmail" class="form-control" autocomplete="email" /><span asp-validation-for="Input.WorkEmail"></span></div>
<div class="col-md-6"><label asp-for="Input.Phone" class="form-label"></label> <span aria-hidden="true">*</span><input asp-for="Input.Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Input.Phone"></span></div>
<div class="col-md-6"><label asp-for="Input.Industry" class="form-label"></label> <span aria-hidden="true">*</span><select asp-for="Input.Industry" class="form-select"><option value="">Select your industry</option><option>Oil &amp; Gas Services</option><option>Engineering &amp; Construction</option><option>Professional Services</option><option>Public Sector</option><option>Facility Management</option><option>Other</option></select><span asp-validation-for="Input.Industry"></span></div>
<div class="col-md-6"><label asp-for="Input.OrganisationSize" class="form-label"></label> <span aria-hidden="true">*</span><select asp-for="Input.OrganisationSize" class="form-select"><option value="">Select organisation size</option><option>1–49 employees</option><option>50–199 employees</option><option>200–499 employees</option><option>500–999 employees</option><option>1,000+ employees</option></select><span asp-validation-for="Input.OrganisationSize"></span></div>
<fieldset class="col-12"><legend class="form-label">Areas of interest <span aria-hidden="true">*</span></legend><div class="row g-2">@foreach(var area in RequestDemoModel.InterestOptions){<div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" name="Input.AreasOfInterest" value="@area" id="interest-@area.Replace(" ", "-").ToLowerInvariant()" /><label class="form-check-label" for="interest-@area.Replace(" ", "-").ToLowerInvariant()">@area</label></div></div>}</div><span asp-validation-for="Input.AreasOfInterest"></span></fieldset>
<div class="col-12"><label asp-for="Input.Message" class="form-label">Message <span class="fw-normal text-secondary">(optional)</span></label><textarea asp-for="Input.Message" class="form-control" rows="5" placeholder="Tell us about your priorities, current systems or intended timeline."></textarea><span asp-validation-for="Input.Message"></span></div>
<div class="honeypot" aria-hidden="true"><label asp-for="Input.Website"></label><input asp-for="Input.Website" tabindex="-1" autocomplete="off" /></div>
<div class="col-12"><div class="form-check"><input asp-for="Input.ConsentToContact" class="form-check-input" /><label asp-for="Input.ConsentToContact" class="form-check-label">I consent to Southbridge Technologies contacting me about this enquiry.</label></div><span asp-validation-for="Input.ConsentToContact"></span></div>
<div class="col-12"><p class="small">Your information will be used to respond to this request. Read our <a asp-page="/Privacy">privacy notice</a>.</p><button class="btn btn-primary btn-lg" type="submit">Request a Demonstration</button></div>
</div></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
