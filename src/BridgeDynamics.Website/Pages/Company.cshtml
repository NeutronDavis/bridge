@page
@{ ViewData["Title"]="Company"; ViewData["Description"]="Southbridge Technologies develops secure, scalable and configurable enterprise software."; }
<partial name="_PageHero" model='new PageHero("Southbridge Technologies","Enterprise software designed for enduring operational value","Southbridge Technologies is an enterprise technology company focused on delivering secure, scalable and configurable business software solutions.")' />
<section class="section"><div class="container-xl"><div class="row g-5"><div class="col-lg-6"><p class="eyebrow">Our focus</p><h2>Technology that strengthens how organisations operate</h2><p>Bridge Dynamics reflects our belief that enterprise software should connect operational reality with disciplined processes, useful information and responsible governance.</p><p>We work to understand how organisations operate, configure technology around sound processes, and support a dependable transition from fragmented tools to a connected platform.</p></div><div class="col-lg-6"><div class="card-grid" style="grid-template-columns:1fr 1fr">@foreach(var item in new[]{("Enterprise engineering","Build for security, maintainability and operational continuity."),("Practical configuration","Adapt the platform to real responsibilities, rules and workflows."),("Professional delivery","Approach implementation with clarity, structure and accountable scope."),("Long-term partnership","Support an operating foundation that can evolve with the organisation.")}){<article class="info-card"><h3>@item.Item1</h3><p>@item.Item2</p></article>}</div></div></div></div></section><partial name="_FinalCta" />
