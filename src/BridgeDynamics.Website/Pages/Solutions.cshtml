@page
@{ ViewData["Title"]="Solutions"; ViewData["Description"]="Bridge Dynamics solutions for connected operations, governance and growth."; }
<partial name="_PageHero" model='new PageHero("Solutions","Address the operational problems that limit performance","Bridge Dynamics connects processes across departments so organisations can improve control, service delivery and decision-making.")' />
<section class="section"><div class="container-xl"><div class="card-grid">@foreach(var item in new[]{("Project and service delivery","Coordinate plans, teams, costs, activity and delivery information from initiation through completion."),("Workforce operations","Connect employee information, time, leave, performance and workforce administration."),("Customer and commercial management","Manage relationships, opportunities, engagements and commercial activity with a shared customer view."),("Procurement and operational control","Structure requests, approvals, purchasing, suppliers, assets and operational processes."),("Governance and compliance","Make policies, risk, controls, evidence, decisions and accountability part of everyday operations."),("Management insight","Give leaders connected dashboards and reports built from operational information across the organisation.")}){<article class="info-card"><h2 class="h4">@item.Item1</h2><p>@item.Item2</p></article>}</div></div></section><partial name="_FinalCta" />
