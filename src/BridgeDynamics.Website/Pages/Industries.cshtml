@page
@{ ViewData["Title"]="Industries"; ViewData["Description"]="Enterprise operating solutions for complex Nigerian and African industries."; }
<partial name="_PageHero" model='new PageHero("Industries","Enterprise capability grounded in operational reality","Bridge Dynamics supports organisations where projects, people, assets, customers and governance must work together.")' />
<section class="section"><div class="container-xl">@foreach(var item in new[]{("Oil & Gas Services","Bring field activity, projects, workforce, assets, procurement and compliance into a controlled operating environment.","Field operations|Contract and project control|Asset visibility|Workforce coordination"),("Engineering & Construction","Connect project delivery with procurement, resources, costs, documentation and management reporting.","Project governance|Resource coordination|Procurement workflow|Commercial visibility"),("Professional Services","Coordinate the customer lifecycle, engagements, people, time and business performance.","Opportunity management|Engagement delivery|Resource planning|Performance insight"),("Public Sector","Support structured processes, responsible access, service delivery and accountable decision-making.","Approval governance|Service workflows|Audit history|Management reporting"),("Facility Management","Manage sites, assets, contracts, service requests, teams and supplier activity from a shared platform.","Service requests|Asset operations|Contract oversight|Supplier coordination")}){<article class="row g-4 py-5 border-bottom"><div class="col-lg-5"><p class="eyebrow">Sector solution</p><h2 class="h3">@item.Item1</h2><p>@item.Item2</p></div><div class="col-lg-7"><ul class="check-list">@foreach(var point in item.Item3.Split('|')){<li>@point</li>}</ul></div></article>}</div></section><partial name="_FinalCta" />
