@{
    var pageTitle = ViewData["Title"] as string ?? "Enterprise Business Operating Platform";
    var description = ViewData["Description"] as string ?? "Bridge Dynamics connects people, projects, finance, operations and governance in one secure enterprise platform.";
    var robots = ViewData["Robots"] as string ?? "index,follow";
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@pageTitle | Bridge Dynamics</title><meta name="description" content="@description" /><meta name="robots" content="@robots" /><link rel="canonical" href="@canonical" />
<meta property="og:type" content="website" /><meta property="og:site_name" content="Bridge Dynamics" /><meta property="og:title" content="@pageTitle" /><meta property="og:description" content="@description" /><meta property="og:url" content="@canonical" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />@await RenderSectionAsync("Head", required: false)@await RenderSectionAsync("StructuredData", required: false)
</head><body>
<a class="skip-link" href="#main-content">Skip to main content</a><partial name="_Header" />
<main id="main-content" tabindex="-1">@RenderBody()</main><partial name="_Footer" />
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
