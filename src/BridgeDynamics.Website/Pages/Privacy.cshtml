@page
@model PrivacyModel
@{ ViewData["Title"]="Privacy"; ViewData["Description"]="How the Bridge Dynamics website handles enquiry information."; }
<partial name="_PageHero" model='new PageHero("Privacy","Website privacy notice","How information submitted through this public website is expected to be handled.")' />
<section class="section"><div class="container-xl"><article class="mx-auto" style="max-width:760px"><div class="alert alert-warning"><strong>Review required:</strong> This prototype notice must be reviewed against the final hosting, analytics and lead-handling arrangements.</div><h2 class="h3">Information you provide</h2><p>When you contact us or request a demonstration, we collect the information entered in the relevant form so that Southbridge Technologies can understand and respond to your enquiry.</p><h2 class="h3 mt-5">How information is used</h2><p>Enquiry information is used to respond, assess requirements, arrange relevant conversations and maintain appropriate business records. It is not connected to the Bridge Dynamics product database by this website.</p><h2 class="h3 mt-5">Retention and protection</h2><p>Final retention periods, subprocessors, hosting locations and contact rights will be documented before production launch.</p><h2 class="h3 mt-5">Contact</h2><p>Questions about privacy can be submitted through the <a asp-page="/Contact">general enquiries form</a>.</p></article></div></section>
