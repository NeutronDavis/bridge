@page
@model ContactModel
@{ ViewData["Title"]="Contact"; ViewData["Description"]="Contact Southbridge Technologies with a general Bridge Dynamics enquiry."; }
<partial name="_PageHero" model='new PageHero("General enquiries","Contact Southbridge Technologies","For company, partnership, support or general product enquiries, send our team a message.")' />
<section class="section section-muted"><div class="container-xl"><div class="form-shell mx-auto">
@if(Model.IsSubmitted){<div class="success-panel" role="status"><div class="success-mark" aria-hidden="true">✓</div><h2>Thank you for contacting us</h2><p>Your enquiry has been received. A member of the Southbridge Technologies team will respond through the contact details you provided.</p><a class="btn btn-outline-primary" asp-page="/Index">Return to home</a></div>}
else{<form method="post" novalidate><div asp-validation-summary="ModelOnly" role="alert"><strong>Please review the highlighted fields.</strong></div><div class="row g-4">
<div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" autocomplete="name" /><span asp-validation-for="Input.Name"></span></div>
<div class="col-md-6"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" autocomplete="email" /><span asp-validation-for="Input.Email"></span></div>
<div class="col-md-6"><label asp-for="Input.Company" class="form-label">Company <span class="fw-normal text-secondary">(optional)</span></label><input asp-for="Input.Company" class="form-control" autocomplete="organization" /><span asp-validation-for="Input.Company"></span></div>
<div class="col-md-6"><label asp-for="Input.EnquiryType" class="form-label"></label><select asp-for="Input.EnquiryType" class="form-select"><option value="">Select an enquiry type</option><option>Product information</option><option>Pricing</option><option>Partnership</option><option>Existing customer support</option><option>Media or corporate enquiry</option><option>Other</option></select><span asp-validation-for="Input.EnquiryType"></span></div>
<div class="col-12"><label asp-for="Input.Message" class="form-label"></label><textarea asp-for="Input.Message" class="form-control" rows="6"></textarea><span asp-validation-for="Input.Message"></span></div>
<div class="honeypot" aria-hidden="true"><label asp-for="Input.Website"></label><input asp-for="Input.Website" tabindex="-1" autocomplete="off" /></div>
<div class="col-12"><button class="btn btn-primary btn-lg" type="submit">Send Enquiry</button></div></div></form>}
</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
