@page
@model IndexModel
@{ ViewData["Title"]="Enterprise Business Operating Platform"; ViewData["Description"]="Run your entire business from one connected platform with Bridge Dynamics."; }
<section class="hero"><div class="container-xl"><div class="row align-items-center g-5"><div class="col-lg-7">
<p class="eyebrow">Enterprise Business Operating Platform</p><h1>Run Your Entire Business From One Connected Platform</h1>
<p class="lead">Bridge Dynamics connects your people, projects, customers, finance, procurement, operations and compliance in one secure enterprise business platform designed for growing organisations.</p>
<div class="hero-actions"><a class="btn btn-primary btn-lg" asp-page="/RequestDemo">Request a Demonstration</a><a class="btn btn-outline-primary btn-lg" asp-page="/Platform">Explore the Platform</a></div>
</div><div class="col-lg-5" aria-hidden="true"><div class="platform-visual"><div class="visual-top"><i></i><i></i><i></i></div><div class="visual-body"><div class="visual-nav"><span></span><span></span><span></span><span></span><span></span></div><div class="visual-content"><div class="visual-title"></div><div class="visual-cards"><div class="visual-card"></div><div class="visual-card"></div><div class="visual-card"></div></div><div class="visual-chart"></div></div></div></div></div></div></div></section>
<section class="section"><div class="container-xl"><div class="section-heading"><p class="eyebrow">The operational challenge</p><h2>Your business should not depend on disconnected information</h2><p>As organisations grow, spreadsheets, email approvals and separate systems make it harder to see what is happening and act with confidence.</p></div><div class="card-grid">
@foreach(var item in new[]{("Disconnected systems","Critical information sits across applications that do not share a common operational view."),("Manual processes","Spreadsheets and email approvals create delays, rework and inconsistent controls."),("Poor reporting","Leadership spends too much time assembling reports and too little time acting on them."),("Operational silos","Teams work independently when customers, projects, people and finance should be connected."),("Fragmented information","Multiple versions of the truth make accountability and planning more difficult."),("Limited control","Unclear ownership and informal processes increase operational and governance risk.")}){<article class="info-card"><h3>@item.Item1</h3><p>@item.Item2</p></article>}
</div></div></section>
<section class="section section-muted"><div class="container-xl"><div class="section-heading"><p class="eyebrow">One platform. Six connected suites.</p><h2>A coordinated foundation for enterprise operations</h2><p>Bridge Dynamics brings core business disciplines together while giving each team the tools and controls relevant to its work.</p></div><div class="card-grid">
@foreach(var item in new[]{("Core Platform","Organisation structure, users, roles, workflow and shared business records."),("People Suite","Workforce records, performance, leave, time and employee operations."),("Customer Suite","Customer relationships, opportunities, engagements and commercial activity."),("Operations Suite","Projects, procurement, assets, service delivery and operational coordination."),("Governance Suite","Policies, risk, compliance, approvals and accountable decision-making."),("Insights Suite","Connected dashboards, reporting and operational intelligence.")}){<article class="info-card"><div class="icon-box" aria-hidden="true">◆</div><h3>@item.Item1</h3><p>@item.Item2</p><a class="link-arrow" asp-page="/Platform">Explore suite</a></article>}
</div></div></section>
<section class="section"><div class="container-xl"><div class="row g-5 align-items-center"><div class="col-lg-5"><p class="eyebrow">Business outcomes</p><h2>Turn connected information into operational confidence</h2><p>Give teams a reliable operating environment and leadership a clearer view of performance, priorities and risk.</p></div><div class="col-lg-7"><div class="card-grid">
@foreach(var item in new[]{"Better operational visibility","Faster decision making","Improved accountability","Streamlined approvals","Connected business operations","Better governance"}){<div class="feature-band"><h3>@item</h3></div>}
</div></div></div></div></section>
<section class="section section-dark"><div class="container-xl"><div class="row g-5 align-items-center"><div class="col-lg-6"><p class="eyebrow eyebrow-light">Designed around how you operate</p><h2>One platform, configured for your organisation</h2><p class="lead">Bridge Dynamics adapts to established operational processes without requiring organisations to maintain separate software products for every workflow.</p></div><div class="col-lg-6"><div class="row"><div class="col-sm-6"><ul class="check-list"><li>Configurable workflows</li><li>Configurable forms</li><li>Business rules</li><li>Role-based permissions</li></ul></div><div class="col-sm-6"><ul class="check-list"><li>Approval processes</li><li>Notifications</li><li>Custom fields</li><li>Customer-specific extensions</li></ul></div></div></div></div></div></section>
<section class="section"><div class="container-xl"><div class="section-heading"><p class="eyebrow">Industry context matters</p><h2>Built for organisations with complex operating requirements</h2></div><div class="card-grid">@foreach(var item in new[]{("Oil & Gas Services","Coordinate field operations, projects, people, assets and compliance."),("Engineering & Construction","Connect project delivery, procurement, workforce and commercial control."),("Professional Services","Manage engagements, resources, customers and performance."),("Public Sector","Support structured service delivery, approvals, governance and accountability."),("Facility Management","Coordinate contracts, assets, service teams and operational requests.")}){<article class="info-card"><h3>@item.Item1</h3><p>@item.Item2</p><a class="link-arrow" asp-page="/Industries">Learn more</a></article>}</div></div></section>
<section class="section section-muted"><div class="container-xl"><div class="row g-5 align-items-center"><div class="col-lg-5"><p class="eyebrow">Security and deployment</p><h2>Controls that support responsible enterprise operations</h2><p>Security is designed into access, data separation, activity history and deployment—not treated as an afterthought.</p><a class="btn btn-outline-primary" asp-page="/Security">Explore security</a></div><div class="col-lg-7"><div class="card-grid">@foreach(var item in new[]{"Role-based security","Tenant isolation","Audit capabilities","Data protection","Secure deployment","Accountable access"}){<article class="info-card"><h3>@item</h3></article>}</div></div></div></div></section>
<partial name="_FinalCta" />
