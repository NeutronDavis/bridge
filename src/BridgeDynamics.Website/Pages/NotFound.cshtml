@page "/404"
@{ Response.StatusCode = 404; ViewData["Title"]="Page Not Found"; ViewData["Description"]="The requested page could not be found."; ViewData["Robots"]="noindex,nofollow"; }
<section class="section"><div class="container-xl"><div class="success-panel"><p class="eyebrow">Error 404</p><h1 class="h2">We could not find that page</h1><p class="lead">The address may have changed, or the page may no longer be available.</p><div class="hero-actions justify-content-center"><a class="btn btn-primary" asp-page="/Index">Return to Home</a><a class="btn btn-outline-primary" asp-page="/Contact">Contact Us</a></div></div></div></section>
